# Copy this file to ".env" (same folder as india-trading-bot.js) and fill in.
# NEVER share .env or upload it anywhere.

# --- Telegram (required) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard login (required, password at least 12 characters) ---
DASH_USER=admin
DASH_PASS=

# --- Angel One (only needed for LIVE, leave empty while testing) ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_PUBLIC_IP=

# --- Live safety (keep LIVE_ENABLED=0 until 30 days of paper results) ---
LIVE_ENABLED=0
LIVE_CAPITAL=5000
LIVE_MAX_PER_TRADE=3000
DASH_URL=
